# DataForge Web Dockerfile
# Multi-stage build for Next.js frontend

# =============================================================================
# Base stage with pnpm
# =============================================================================
FROM node:22-alpine AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.15.1 --activate

WORKDIR /app

# =============================================================================
# Development stage
# =============================================================================
FROM base AS development

# Copy package files and npmrc for consistent hoisting
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/web/package.json apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source files (exclude node_modules which was created by pnpm install)
COPY apps/web/src apps/web/src
COPY apps/web/public apps/web/public
COPY apps/web/next.config.ts apps/web/
COPY apps/web/postcss.config.mjs apps/web/
COPY apps/web/tailwind.config.ts apps/web/
COPY apps/web/tsconfig.json apps/web/
COPY apps/web/eslint.config.mjs apps/web/
COPY tsconfig.json ./

EXPOSE 3000

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

CMD ["pnpm", "--filter", "@dataforge/web", "dev"]

# =============================================================================
# Builder stage
# =============================================================================
FROM base AS builder

# Build-time arguments for API URL (used in Next.js rewrites)
ARG INTERNAL_API_URL=http://api:8000
ENV INTERNAL_API_URL=$INTERNAL_API_URL

# Copy package files and npmrc for consistent hoisting
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/web/package.json apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source files (exclude node_modules which was created by pnpm install)
COPY apps/web/src apps/web/src
COPY apps/web/public apps/web/public
COPY apps/web/next.config.ts apps/web/
COPY apps/web/postcss.config.mjs apps/web/
COPY apps/web/tailwind.config.ts apps/web/
COPY apps/web/tsconfig.json apps/web/
COPY apps/web/eslint.config.mjs apps/web/
COPY tsconfig.json ./

# Build - run from web directory for reliable module resolution
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app/apps/web
RUN pnpm exec next build
WORKDIR /app

# =============================================================================
# Production stage
# =============================================================================
FROM node:22-alpine AS production

WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy built application (monorepo structure: standalone has apps/web subdirectory)
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs

EXPOSE 3000

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV INTERNAL_API_URL="http://api:8000"

WORKDIR /app/apps/web

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["node", "server.js"]
